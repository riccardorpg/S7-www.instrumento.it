{% extends 'base.html.twig' %}

{% block title %} - {{ title }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, follow">{% endblock %}

{% block content %}
    <section class="eb-section" style="padding-top:140px;">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    <h1 class="mb-4">{{ title }}</h1>
                    <div class="alert alert-secondary">
                        Contenuto in preparazione. <em>(placeholder: inserire il testo definitivo di «{{ title }}»)</em>
                    </div>
                    <p class="text-muted">
                        Questa pagina conterrà l'informativa completa relativa a «{{ title|lower }}».
                        Il testo sarà fornito dal titolare del trattamento / ufficio legale.
                    </p>
                    <a href="{{ path('homepage') }}" class="button button-3d button-rounded button-dark">&larr; Torna alla home</a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
