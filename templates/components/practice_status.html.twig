{# ===========================================================================
   BADGE DELLO STATO PRATICA — un solo posto per i colori, usato da tutte le
   liste e schede (agenzia e notaio).

   Uso:  {% import 'components/practice_status.html.twig' as practiceStatus %}
         {{ practiceStatus.badge(p.status, p.statusLabel) }}
         {{ practiceStatus.badge(p.status, p.statusLabel, 'ms-auto') }}

   Colori (12.3.5): Aperta = arancione, Completata = verde,
   Archiviabile = azzurro, Archiviata = grigio.
   =========================================================================== #}

{% macro badge(status, label, class = '') %}
    {%- set colors = {
        'open':       'bg-warning text-dark',
        'completed':  'bg-success',
        'archivable': 'bg-info text-dark',
        'archived':   'bg-secondary',
    } -%}
    <span class="badge {{ class }} {{ colors[status]|default('bg-secondary') }}">{{ label }}</span>
{% endmacro %}

{# Lo stesso stato come pallino (nelle liste), il nome nel tooltip. Stessi colori del badge.
   Uso: {{ practiceStatus.dot(p.status, p.statusLabel) }} #}
{% macro dot(status, label) %}
    {%- set colors = {
        'open':       'bg-warning',
        'completed':  'bg-success',
        'archivable': 'bg-info',
        'archived':   'bg-secondary',
    } -%}
    <span class="rpg_color_dot {{ colors[status]|default('bg-secondary') }}" data-bs-toggle="tooltip" data-bs-title="{{ label }}"></span>
{% endmacro %}
