{# =====================================================================
   Modale filtro "a scelta multipla" (stile eposmanager/DualMoto, BS5).
   Variabili (include ... only):
     number  : id univoco del filtro nella pagina (1, 2, ...)
     title   : titolo della modale
     options : lista di {id, label[, color]} (id = valore inviato al backend; label = testo;
               color opzionale: pallino di quel colore prima del testo, es. contrassegni e tag)
   Da abbinare a:
     - input visibile  #filter_multi_value_{{ number }} (readonly, onclick filterMulti{{ number }}())
     - input hidden     #filter_multi_id_{{ number }}    (name = chiave del filtro)
     - components/js/filter_multi_js.html.twig con lo stesso number
   ===================================================================== #}
<div id="filterMultiModal{{ number }}" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header"><h3 class="modal-title">{{ title }}</h3></div>
            <div class="modal-stripe"></div>
            <div class="modal-body">
                <div class="row">
                    {# Ricerca: nasconde i valori che non contengono il testo digitato #}
                    <div class="col-12 m_b_10p">
                        <input type="text" id="filterMultiSearch{{ number }}" class="form-control form-control-sm" placeholder="Cerca valore..." autocomplete="off" onkeyup="filterMultiSearch{{ number }}()">
                    </div>
                    {# "Filtrati" = i valori rimasti visibili dalla ricerca; "Deseleziona tutti" agisce anche sui nascosti #}
                    <div class="col-12 m_b_20p">
                        <button type="button" class="button button-3d button-mini button-green m_none" onclick="filterMultiFiltered{{ number }}(true)">Seleziona filtrati</button>
                        <button type="button" class="button button-3d button-mini button-amber m_l_5p" onclick="filterMultiFiltered{{ number }}(false)">Deseleziona filtrati</button>
                        <button type="button" class="button button-3d button-mini button-red m_l_5p" onclick="filterMultiAll{{ number }}(false)">Deseleziona tutti</button>
                    </div>
                    <div class="col-12">
                        <table class="table table-sm table-borderless mb-2 multi-filter-table v_a_m">
                            {% for o in options %}
                                <tr class="filter_multi_row_{{ number }}">
                                    <td class="td_w_40p txt_a_c">
                                        <input type="checkbox" class="form-check-input switch_multi_{{ number }}" id="multi_{{ number }}_{{ loop.index }}" data-id="{{ o.id }}" data-val="{{ o.label }}">
                                    </td>
                                    <td class="txt_a_l"><label class="m_b_none" for="multi_{{ number }}_{{ loop.index }}">{% if o.color is defined and o.color %}<span class="rpg_color_dot m_r_5p" style="background:{{ o.color }};"></span>{% endif %}{{ o.label }}</label></td>
                                </tr>
                            {% else %}
                                <tr><td class="text-muted txt_a_c">Nessun valore disponibile.</td></tr>
                            {% endfor %}
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="button button-3d button-small button-red f_left" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="button button-3d button-small button-green f_right" onclick="setFilterMulti{{ number }}()">Aggiorna filtro</button>
            </div>
        </div>
    </div>
</div>
