{# =====================================================================
   Collegamento a una sezione dalla scrivania (CONVENZIONI 8): la scrivania mostra le stesse voci
   del menu, nello stesso ordine, con le configurazioni in fondo. Va dentro una <div class="row">.
   Variabili (include ... only):
     route   : rotta della sezione
     icon    : icona Bootstrap Icons, senza prefisso (es. 'people')
     title   : nome della sezione, come nel menu
     text    : una riga su cosa si fa nella sezione
     visible : (opz) false per nasconderla, con lo stesso permesso che nasconde la voce di menu
   ===================================================================== #}
{% if visible is not defined or visible %}
    <div class="col-12 col-md-6 col-lg-3">
        <a href="{{ path(route) }}" class="card h-100 text-decoration-none rpg_page_link">
            <div class="card-body d-flex align-items-start gap-3">
                <i class="bi-{{ icon }} color_pr" style="font-size:2rem; line-height:1;"></i>
                <div>
                    <h5 class="m_b_5p rpg_keep">{{ title }}</h5>
                    <small class="op_07">{{ text }}</small>
                </div>
            </div>
        </a>
    </div>
{% endif %}
