{# 10.2 Campi del membro dello staff (AgencyStaffType). Variabile: form.
   I permessi si gestiscono a parte (10.1.5). Errori su un div senza altre classi (form/errors.html.twig). #}
<div class="row g-3">
    <div class="col-md-6"><div {{ form_errors(form.name) }}><label class="form-label" for="{{ form.name.vars.id }}">Nome *</label>{{ form_widget(form.name) }}</div></div>
    <div class="col-md-6"><div {{ form_errors(form.surname) }}><label class="form-label" for="{{ form.surname.vars.id }}">Cognome *</label>{{ form_widget(form.surname) }}</div></div>
    <div class="col-12"><div {{ form_errors(form.email) }}><label class="form-label" for="{{ form.email.vars.id }}">E-mail *</label>{{ form_widget(form.email) }}</div></div>
    <div class="col-12">
        <div {{ form_errors(form.staffRole) }}><label class="form-label" for="{{ form.staffRole.vars.id }}">Ruolo *</label>{{ form_widget(form.staffRole) }}</div>
        <small class="op_07">L'amministratore ha sempre accesso completo, senza passare dai permessi.</small>
    </div>
</div>
