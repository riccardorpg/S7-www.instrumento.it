{% extends 'role/agency/layout.html.twig' %}
{% import 'components/action_icons.html.twig' as ico %}

{% block title %} - Staff{% endblock %}
{% block role_page_title_inner %}Staff{% endblock %}

{% block role_page_title_breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('agency_index') }}">Agenzia</a></li>
    <li class="breadcrumb-item active" aria-current="page">Staff</li>
{% endblock %}

{% block sub_menu_left %}
    <li class="nav-item"><a class="nav-link" href="{{ path('agency_index') }}"><i class="bi-arrow-left"></i> Torna alla scrivania</a></li>
{% endblock %}

{% block sub_menu_right %}
    {% if is_granted('edit', 'staff') %}
        <li class="nav-item"><a class="nav-link" href="javascript:staffNewOpen()"><i class="bi-plus-lg"></i> Nuovo</a></li>
    {% endif %}
{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">
            <form id="staffFilter" method="get" action="{{ path('agency_staff') }}">
                <input type="hidden" name="filterSet" value="1">
                <input type="hidden" id="staffFilter_sort" name="sortField" value="{{ filters.sortField }}">
                <input type="hidden" id="staffFilter_direction" name="sortOrder" value="{{ filters.sortOrder }}">
            </form>

            <table class="table table-hover table-bordered align-middle m_b_none v_a_m">
                <thead>
                    <tr class="tr_filter">
                        {# 10.1.6 Stato: select attivi/sospesi #}
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                {{ ico.action(path('remove_filter', {route: 'agency_staff'}), 'close', 'Escludi filtro', 'red', 'icon_sm') }}
                                <select form="staffFilter" name="f_active" class="form-select form-select-sm">
                                    <option value="">Tutti</option>
                                    <option value="1"{{ filters.active == '1' ? ' selected' : '' }}>Attivi</option>
                                    <option value="0"{{ filters.active == '0' ? ' selected' : '' }}>Sospesi</option>
                                </select>
                            </div>
                        </td>
                        <td><input form="staffFilter" name="f_surname" value="{{ filters.surname }}" class="form-control form-control-sm"></td>
                        <td><input form="staffFilter" name="f_name" value="{{ filters.name }}" class="form-control form-control-sm"></td>
                        <td><input form="staffFilter" name="f_email" value="{{ filters.email }}" class="form-control form-control-sm"></td>
                        {# 10.1.4 Ruolo: scelta multipla in modale #}
                        <td>
                            <input form="staffFilter" type="text" class="form-control form-control-sm cursor_p" id="filter_multi_value_1"
                                   readonly onclick="filterMulti1()" autocomplete="off">
                            <input form="staffFilter" type="hidden" id="filter_multi_id_1" name="f_role" value="{{ filters.role }}">
                        </td>
                        <td class="txt_a_c text-nowrap">
                            <button form="staffFilter" type="submit" class="btn p-0 border-0 bg-transparent" data-bs-toggle="tooltip" data-bs-title="Filtra">
                                <img src="{{ asset(PATH_GRAPHICS ~ 'icons/search.png') }}" class="icon_action icon_sm icon_green" alt="Filtra">
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <th class="td_w_100p txt_a_c">Stato</th>
                        <th>{{ ico.sort('Cognome', 'u.surname') }}</th>
                        <th>{{ ico.sort('Nome', 'u.name') }}</th>
                        <th>{{ ico.sort('E-mail', 'u.email') }}</th>
                        <th class="td_w_120p">{{ ico.sort('Ruolo', 'u.staffRole') }}</th>
                        <th class="td_w_150p txt_a_c">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                {% for u in records %}
                    <tr>
                        {# 10.1.6 Stato account #}
                        <td class="txt_a_c">
                            <img src="{{ asset(PATH_GRAPHICS ~ 'icons/' ~ (u.active ? 'circle_green' : 'circle_red') ~ '.png') }}"
                                 class="icon_status" alt="{{ u.active ? 'Attivo' : 'Sospeso' }}"
                                 data-bs-toggle="tooltip" data-bs-title="{{ u.active ? 'Attivo' : 'Sospeso' }}">
                        </td>
                        <td>{{ u.surname ?: '-' }}</td>
                        <td>{{ u.name ?: '-' }}</td>
                        <td>{{ u.email }}</td>
                        {# Ruolo: pallino colorato, il nome nel tooltip #}
                        <td class="txt_a_c">
                            <span class="rpg_color_dot {{ u.staffRole == 'admin' ? 'bg-success' : (u.staffRole == 'internal' ? 'bg-primary' : 'bg-info') }}"
                                  data-bs-toggle="tooltip" data-bs-title="{{ u.staffRoleLabel }}"></span>
                        </td>
                        <td class="txt_a_c text-nowrap">
                            {% if is_granted('edit', 'staff') %}
                                {# 10.1.5 Gestione permessi piattaforma #}
                                {# Livelli salvati (non quelli derivati dal ruolo admin): la matrice mostra ciò che è a DB. #}
                                {% set levels = {} %}
                                {% for up in u.userPermissions %}
                                    {% set levels = levels|merge({(up.permission.slug): up.value}) %}
                                {% endfor %}
                                <a href="javascript:void(0)" class="d-inline-block m_r_5p" data-bs-toggle="tooltip" data-bs-title="Permessi piattaforma"
                                   onclick="staffPermissionsOpen(this)"
                                   data-id="{{ u.id }}" data-action="{{ path('agency_staff_permissions', {id: u.id}) }}" data-fullname="{{ u.fullName }}" data-admin="{{ u.isAdmin ? 1 : 0 }}"
                                   data-levels="{{ levels|json_encode }}">
                                    <img src="{{ asset(PATH_GRAPHICS ~ 'icons/permission.png') }}" class="icon_action icon_green" alt="Permessi">
                                </a>
                                {# 10.1.7 Invia credenziali #}
                                {{ ico.action(
                                    "javascript:staffCredentialsAsk('" ~ path('agency_staff_credentials', {id: u.id}) ~ "', 'genererai nuove credenziali di accesso per " ~ u.email|e('js') ~ "')",
                                    'key', 'Invia credenziali', 'amber'
                                ) }}
                                {# 10.1.8 Attiva/sospendi #}
                                {{ ico.action(
                                    "javascript:staffToggleAsk('" ~ path('agency_staff_toggle', {id: u.id}) ~ "', '" ~ (u.active ? 'sospenderai' : 'riattiverai') ~ " l\\'account di " ~ u.fullName|e('js') ~ "')",
                                    'exchange', u.active ? 'Sospendi' : 'Attiva', u.active ? 'amber' : 'green'
                                ) }}
                                {# Modifica anagrafica e ruolo #}
                                <a href="javascript:void(0)" class="d-inline-block m_r_5p" data-bs-toggle="tooltip" data-bs-title="Modifica"
                                   onclick="staffEditOpen(this)"
                                   data-id="{{ u.id }}" data-action="{{ path('agency_staff', {edit: u.id}) }}" data-name="{{ u.name }}" data-surname="{{ u.surname }}"
                                   data-email="{{ u.email }}" data-role="{{ u.staffRole }}">
                                    <img src="{{ asset(PATH_GRAPHICS ~ 'icons/edit.png') }}" class="icon_action icon_amber" alt="Modifica">
                                </a>
                            {% else %}
                                <span class="op_07 font_13">Sola lettura</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="op_07 text-center">Nessun membro dello staff trovato.</td></tr>
                {% endfor %}
                </tbody>
            </table>
            {% include 'components/table/paginator.html.twig' with {records: records} only %}
        </div>
    </section>
{% endblock %}

{% block modals %}
    {% if is_granted('edit', 'staff') %}
        {% embed 'components/modals/form.html.twig' with {type: 'staffNew', title: 'Nuovo membro dello staff', form: formNew} %}
            {% block modalBody %}{{ include('role/agency/staff/_form_fields.html.twig', {form: formNew}) }}{% endblock %}
            {% block modalSubmit %}Crea{% endblock %}
        {% endembed %}

        {% embed 'components/modals/form.html.twig' with {type: 'staffEdit', title: 'Modifica membro dello staff', form: formEdit} %}
            {% block modalBody %}{{ include('role/agency/staff/_form_fields.html.twig', {form: formEdit}) }}{% endblock %}
        {% endembed %}

        {# 10.1.5 Matrice permessi #}
        {% embed 'components/modals/form.html.twig' with {type: 'staffPermissions', title: 'Permessi piattaforma', size: 'modal-lg'} %}
            {% block modalBody %}
                <p class="op_07 font_13" id="staffPermissions_subject"></p>
                <div class="alert alert-info font_13 d-none" id="staffPermissions_adminNote">
                    Questo membro è <strong>amministratore</strong>: ha accesso completo a tutte le sezioni e i livelli qui sotto non vengono applicati.
                </div>
                <table class="table table-bordered align-middle m_b_none v_a_m">
                    <thead>
                        <tr>
                            <th>Sezione</th>
                            <th class="td_w_120p txt_a_c">Nessuno</th>
                            <th class="td_w_120p txt_a_c">Lettura</th>
                            <th class="td_w_150p txt_a_c">Lettura/scrittura</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for p in permissions %}
                        <tr>
                            <td>{{ p.value }}</td>
                            <td class="txt_a_c"><input class="form-check-input" type="radio" name="permissions[{{ p.slug }}]" value="" data-slug="{{ p.slug }}" checked></td>
                            <td class="txt_a_c"><input class="form-check-input" type="radio" name="permissions[{{ p.slug }}]" value="r" data-slug="{{ p.slug }}"></td>
                            <td class="txt_a_c"><input class="form-check-input" type="radio" name="permissions[{{ p.slug }}]" value="rw" data-slug="{{ p.slug }}"></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="op_07 text-center">Catalogo permessi vuoto: lancia <code>app:sync-permissions</code>.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endblock %}
        {% endembed %}

        {% include 'components/modals/confirm.html.twig' with {type: 'staffCredentials', title: 'Invia credenziali'} only %}
        {% include 'components/modals/confirm.html.twig' with {type: 'staffToggle', title: 'Stato account'} only %}
    {% endif %}

    {# Filtro ruolo a scelta multipla (10.1.4) #}
    {% include 'components/modals/filter_multi.html.twig' with {
        number: 1,
        title: 'Filtra per ruolo',
        options: roles|map((label, value) => {'id': value, 'label': label})
    } only %}
{% endblock %}

{% block page_javascripts %}
{% if is_granted('edit', 'staff') %}
<script>
    var STAFF_CREDENTIALS_TOKEN = "{{ csrf_token('staffCredentials') }}";
    var STAFF_TOGGLE_TOKEN = "{{ csrf_token('staffToggle') }}";

    function staffNewOpen() {
        document.getElementById('staffNewForm').reset();
        staffNewShow();
    }

    function staffEditOpen(el) {
        var f = document.getElementById('staffEditForm');
        f.action = el.dataset.action;
        document.getElementById('agency_staff_edit_name').value = el.dataset.name || '';
        document.getElementById('agency_staff_edit_surname').value = el.dataset.surname || '';
        document.getElementById('agency_staff_edit_email').value = el.dataset.email || '';
        document.getElementById('agency_staff_edit_staffRole').value = el.dataset.role || 'internal';
        staffEditShow();
    }

    /* 10.1.5 Apre la matrice con i livelli già assegnati al membro. */
    function staffPermissionsOpen(el) {
        var form = document.getElementById('staffPermissionsForm');
        form.action = el.dataset.action;
        document.getElementById('staffPermissions_subject').textContent = 'Membro: ' + el.dataset.fullname;
        document.getElementById('staffPermissions_adminNote').classList.toggle('d-none', el.dataset.admin !== '1');

        var levels = JSON.parse(el.dataset.levels || '{}');
        form.querySelectorAll('input[type="radio"][data-slug]').forEach(function (radio) {
            radio.checked = (levels[radio.dataset.slug] || '') === radio.value;
        });
        staffPermissionsShow();
    }

    function staffCredentialsAsk(url, message) {
        staffCredentialsConfirm(url, STAFF_CREDENTIALS_TOKEN, message);
    }

    function staffToggleAsk(url, message) {
        staffToggleConfirm(url, STAFF_TOGGLE_TOKEN, message);
    }
</script>
{% endif %}
{% include 'components/table/sort_js.html.twig' with {
    formName: 'staffFilter', sortId: 'staffFilter_sort', directionId: 'staffFilter_direction',
    actualSort: filters.sortField, actualDirection: filters.sortOrder
} only %}
{% include 'components/js/filter_multi_js.html.twig' with {number: 1} only %}
{% endblock %}
