{% extends 'role/agency/layout.html.twig' %}
{% import 'components/action_icons.html.twig' as ico %}
{% import 'components/practice_status.html.twig' as practiceStatus %}

{% block title %} - Scrivania{% endblock %}
{% block role_page_title_inner %}Benvenuto {{ app.user.fullName }}{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        {# A tutta larghezza: a sinistra le pratiche contrassegnate, a destra spazio e avvisi. #}
        <div class="container-fluid">
            <div class="row g-3">
                {# ===== 9.3 Pratiche contrassegnate ===== #}
                <div class="col-lg-8">
                    <div class="card h-100">
                        <div class="card-body">
                            <h6 class="m_b_10p">Pratiche contrassegnate <span class="badge bg-secondary">{{ markedPractices|length }}</span></h6>

                            {% if markedPractices is empty %}
                                <p class="op_07 m_b_none">Nessuna pratica contrassegnata.</p>
                            {% else %}
                                <table class="table table-hover table-bordered align-middle m_b_none v_a_m">
                                    <thead>
                                        <tr>
                                            <th class="td_w_100p txt_a_c">Contr.</th>
                                            <th class="td_w_70p txt_a_c">Stato</th>
                                            <th class="td_w_150p">Codice</th>
                                            <th>Venditore</th>
                                            <th>Acquirente</th>
                                            <th>Indirizzo</th>
                                            <th class="td_w_100p txt_a_c">Scheda</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    {% for p in markedPractices %}
                                        <tr>
                                            <td class="txt_a_c"><span class="rpg_color_dot" style="background:{{ p.mark.color }};" data-bs-toggle="tooltip" data-bs-title="{{ p.mark.value }}"></span></td>
                                            <td class="txt_a_c">{{ practiceStatus.dot(p.status, p.statusLabel) }}</td>
                                            <td><a href="{{ path('agency_practice_sheet', {id: p.id}) }}"><strong>{{ p.number }}</strong></a></td>
                                            <td>{{ p.seller ? p.seller.fullName : '-' }}</td>
                                            <td>{{ p.buyer ? p.buyer.fullName : '-' }}</td>
                                            <td>{{ p.address ?: '-' }}</td>
                                            <td class="txt_a_c">{{ ico.action(path('agency_practice_sheet', {id: p.id}), 'sheet', 'Apri la scheda', 'pr') }}</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# Spazio e avvisi, uno sotto l'altro #}
                <div class="col-lg-4 d-flex flex-column gap-3">
                    {# ===== 9.1 Spazio disponibile / spazio totale licenza ===== #}
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 m_b_10p">
                                <h6 class="m_b_none">Spazio della licenza</h6>
                                {% if company %}<span class="op_07 font_13">{{ company.licenseTypeLabel }}</span>{% endif %}
                            </div>

                            {% if quotaMb > 0 %}
                                {% set freeMb = (quotaMb - usedMb) > 0 ? quotaMb - usedMb : 0 %}
                                <div class="progress m_b_10p" style="height:20px;">
                                    <div class="progress-bar{{ usedPercent >= 90 ? ' bg-danger' : (usedPercent >= 70 ? ' bg-warning' : '') }}"
                                         role="progressbar" style="width: {{ usedPercent < 3 ? 3 : usedPercent }}%;"
                                         aria-valuenow="{{ usedPercent }}" aria-valuemin="0" aria-valuemax="100">{{ usedPercent }}%</div>
                                </div>
                                <table class="table align-middle m_b_none v_a_m">
                                    <tr>
                                        <th style="width:50%">Spazio disponibile</th>
                                        <td><strong>{{ freeMb|number_format(1, ',', '.') }} MB</strong></td>
                                    </tr>
                                    <tr><th>Spazio occupato</th><td>{{ usedMb|number_format(1, ',', '.') }} MB</td></tr>
                                    <tr><th>Spazio totale licenza</th><td>{{ quotaMb|number_format(0, ',', '.') }} MB</td></tr>
                                    {% if company and company.licenseExpiresAt %}
                                        {% set days = company.daysToExpiry %}
                                        <tr>
                                            <th>Scadenza licenza</th>
                                            <td>
                                                {{ company.licenseExpiresAt|date('d/m/Y') }}
                                                {% if days is not null and days <= 30 %}
                                                    <span class="badge {{ days < 0 ? 'bg-danger' : 'bg-warning text-dark' }}">{{ days < 0 ? 'scaduta' : 'fra ' ~ days ~ ' giorni' }}</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endif %}
                                </table>
                                {% if usedPercent >= 90 %}
                                    <p class="font_13 p_t_10p m_b_none">
                                        <span class="rpg_color_dot bg-danger" data-bs-toggle="tooltip" data-bs-title="Attenzione"></span>
                                        Spazio quasi esaurito: contatta l'amministratore per ampliare la licenza.
                                    </p>
                                {% endif %}
                            {% else %}
                                <p class="op_07 m_b_none">Nessuna licenza configurata per questa agenzia.</p>
                            {% endif %}
                        </div>
                    </div>

                    {# ===== 9.2 Avvisi pratiche, in due schede (la scheda attiva resta in sessione, tab_session):
                       gli avvisi e i documenti che il notaio ha rimandato all'agenzia ===== #}
                    {% set activeTab = app.session.get('agency_index_tab') == 'documenti' ? 'documenti' : 'avvisi' %}
                    <div class="card flex-grow-1">
                        <div class="card-body">
                            <h6 class="m_b_10p">Avvisi pratiche</h6>

                            <ul class="nav nav-tabs canvas-alt-tabs tabs-tb m_b_10p" role="tablist">
                                <li class="nav-item">
                                    <button type="button" class="nav-link tab_session{{ activeTab == 'avvisi' ? ' active' : '' }}" data-filter-tab="avvisi" data-bs-toggle="tab" data-bs-target="#desk-avvisi">
                                        Avvisi <span class="badge {{ alerts is empty ? 'bg-secondary' : 'bg-danger' }}">{{ alerts|length }}</span>
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button type="button" class="nav-link tab_session{{ activeTab == 'documenti' ? ' active' : '' }}" data-filter-tab="documenti" data-bs-toggle="tab" data-bs-target="#desk-documenti">
                                        Documenti da verificare <span class="badge {{ toVerify is empty ? 'bg-secondary' : 'bg-info text-dark' }}">{{ toVerify|length }}</span>
                                    </button>
                                </li>
                            </ul>

                            <div class="tab-content">
                                {# (1) Avvisi, i più imminenti per primi #}
                                <div class="tab-pane fade{{ activeTab == 'avvisi' ? ' show active' : '' }}" id="desk-avvisi">
                                    {% if alerts is empty %}
                                        <p class="op_07 m_b_none">Nessun avviso inserito sulle pratiche.</p>
                                    {% else %}
                                        <table class="table table-hover align-middle m_b_none v_a_m">
                                            <thead>
                                                <tr>
                                                    <th class="td_w_120p">Data</th>
                                                    <th class="td_w_120p">Pratica</th>
                                                    <th>Messaggio</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            {% for a in alerts %}
                                                <tr>
                                                    <td>
                                                        {{ a.remindAt|date('d/m/Y') }}
                                                        {% if a.due %}<span class="badge bg-danger">scaduto</span>{% endif %}
                                                    </td>
                                                    <td><a href="{{ path('agency_practice_sheet', {id: a.practice.id}) }}">{{ a.practice.number }}</a></td>
                                                    <td>{{ a.message }}</td>
                                                </tr>
                                            {% endfor %}
                                            </tbody>
                                        </table>
                                    {% endif %}
                                </div>

                                {# (2) Documenti "da verificare agenzia": il notaio chiede un nuovo allegato #}
                                <div class="tab-pane fade{{ activeTab == 'documenti' ? ' show active' : '' }}" id="desk-documenti">
                                    {% if toVerify is empty %}
                                        <p class="op_07 m_b_none">Nessun documento da verificare per l'agenzia.</p>
                                    {% else %}
                                        <table class="table table-hover align-middle m_b_none v_a_m">
                                            <thead>
                                                <tr>
                                                    <th class="td_w_120p">Pratica</th>
                                                    <th>Documento</th>
                                                    <th class="td_w_70p txt_a_c">Scheda</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            {% for r in toVerify %}
                                                <tr>
                                                    <td><a href="{{ path('agency_practice_sheet', {id: r.practice.id}) }}">{{ r.practice.number }}</a></td>
                                                    <td>{{ r.label }}</td>
                                                    <td class="txt_a_c">{{ ico.action(path('agency_practice_sheet', {id: r.practice.id}), 'sheet', 'Apri la pratica', 'pr') }}</td>
                                                </tr>
                                            {% endfor %}
                                            </tbody>
                                        </table>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block page_javascripts %}
    {% include 'components/js/tab_session_js.html.twig' %}
{% endblock %}
