{% extends 'role/agency/layout.html.twig' %}
{% import 'components/action_icons.html.twig' as ico %}

{% block title %} - Pratiche{% endblock %}
{% block role_page_title_inner %}Pratiche{% endblock %}

{% block role_page_title_breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('agency_index') }}">Agenzia</a></li>
    <li class="breadcrumb-item active" aria-current="page">Pratiche</li>
{% endblock %}

{% block sub_menu_left %}
    <li class="nav-item"><a class="nav-link" href="{{ path('agency_index') }}"><i class="bi-arrow-left"></i> Torna alla scrivania</a></li>
{% endblock %}

{% block sub_menu_right %}
    {% if is_granted('edit', 'practices') %}
        <li class="nav-item"><a class="nav-link" href="{{ path('agency_practice_new') }}"><i class="bi-plus-lg"></i> Nuova pratica</a></li>
    {% endif %}
{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container-fluid">
            <form id="practiceFilter" method="get" action="{{ path('agency_practices') }}">
                <input type="hidden" name="filterSet" value="1">
                <input type="hidden" id="practiceFilter_sort" name="sortField" value="{{ filters.sortField }}">
                <input type="hidden" id="practiceFilter_direction" name="sortOrder" value="{{ filters.sortOrder }}">
            </form>

            {# 12.1.1 Una scheda per stato, col numero di pratiche (stessi filtri). La scheda attiva sta in
               sessione: il clic passa da agency_practice_tab, che la salva e torna all'elenco. #}
            {% set tabPlurals = {open: 'Aperte', completed: 'Completate', archived: 'Archiviate'} %}
            <ul class="nav nav-tabs canvas-alt-tabs tabs-tb m_b_20p" role="tablist">
                {% for value, label in statuses %}
                    <li class="nav-item">
                        <a class="nav-link{{ filters.status == value ? ' active' : '' }}" href="{{ path('agency_practice_tab', {status: value}) }}">
                            {{ tabPlurals[value]|default(label) }} <span class="badge bg-secondary">{{ statusCounts[value] }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>

            <table class="table table-hover table-bordered align-middle m_b_none v_a_m">
                <thead>
                    <tr class="tr_filter">
                        {# Contrassegno e tag: scelta multipla in modale #}
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                {{ ico.action(path('remove_filter', {route: 'agency_practices'}), 'close', 'Azzera filtri', 'red') }}
                                <input form="practiceFilter" type="text" class="form-control form-control-sm cursor_p" id="filter_multi_value_2"
                                       readonly onclick="filterMulti2()" autocomplete="off">
                                <input form="practiceFilter" type="hidden" id="filter_multi_id_2" name="f_mark" value="{{ filters.mark }}">
                            </div>
                        </td>
                        <td>
                            <input form="practiceFilter" type="text" class="form-control form-control-sm cursor_p" id="filter_multi_value_3"
                                   readonly onclick="filterMulti3()" autocomplete="off">
                            <input form="practiceFilter" type="hidden" id="filter_multi_id_3" name="f_tag" value="{{ filters.tag }}">
                        </td>
                        <td><input form="practiceFilter" name="f_number" value="{{ filters.number }}" class="form-control form-control-sm"></td>
                        <td><input form="practiceFilter" name="f_address" value="{{ filters.address }}" class="form-control form-control-sm"></td>
                        <td><input form="practiceFilter" name="f_seller" value="{{ filters.seller }}" class="form-control form-control-sm"></td>
                        <td><input form="practiceFilter" name="f_buyer" value="{{ filters.buyer }}" class="form-control form-control-sm"></td>
                        <td>
                            <select form="practiceFilter" name="f_mortgage" class="form-select form-select-sm">
                                <option value="">Tutte</option>
                                <option value="1"{{ filters.mortgage == '1' ? ' selected' : '' }}>Con mutuo</option>
                                <option value="0"{{ filters.mortgage == '0' ? ' selected' : '' }}>Senza mutuo</option>
                            </select>
                        </td>
                        {# Data creazione: intervallo #}
                        <td>
                            <input form="practiceFilter" type="text" id="practiceFilter_created" name="f_created" value="{{ filters.created }}"
                                   class="form-control form-control-sm cursor_p" autocomplete="off" readonly>
                        </td>
                        <td></td>
                        <td class="txt_a_c text-nowrap">
                            <button form="practiceFilter" type="submit" class="btn p-0 border-0 bg-transparent" data-bs-toggle="tooltip" data-bs-title="Filtra">
                                <img src="{{ asset(PATH_GRAPHICS ~ 'icons/search.png') }}" class="icon_action icon_green" alt="Filtra">
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <th class="td_w_100p">{{ ico.sort('Contr.', 'm.value', 'Contrassegno') }}</th>
                        <th class="td_w_100p">{{ ico.sort('Tag', 'tagSort') }}</th>
                        <th class="td_w_150p">{{ ico.sort('Codice', 'p.number') }}</th>
                        <th>{{ ico.sort('Indirizzo', 'p.address') }}</th>
                        <th>Venditore</th>
                        <th>Acquirente</th>
                        <th class="td_w_100p">{{ ico.sort('Mutuo', 'p.mortgage') }}</th>
                        <th class="td_w_120p">{{ ico.sort('Data cr.', 'p.createdAt', 'Data creazione') }}</th>
                        <th class="td_w_100p txt_a_c">Spazio</th>
                        <th class="td_w_100p txt_a_c">Scheda</th>
                    </tr>
                </thead>
                <tbody>
                {% for p in records %}
                    <tr>
                        {# Contrassegno e tag: pallini del loro colore, il nome nel tooltip #}
                        <td class="txt_a_c">
                            {% if p.mark %}
                                <span class="rpg_color_dot" style="background:{{ p.mark.color }};" data-bs-toggle="tooltip" data-bs-title="{{ p.mark.value }}"></span>
                            {% else %}-{% endif %}
                        </td>
                        <td class="txt_a_c">
                            {% for t in p.tags %}
                                <span class="rpg_color_dot" style="background:{{ t.color }};" data-bs-toggle="tooltip" data-bs-title="{{ t.value }}"></span>
                            {% else %}-{% endfor %}
                        </td>
                        <td><a href="{{ path('agency_practice_sheet', {id: p.id}) }}"><strong>{{ p.number }}</strong></a></td>
                        <td>{{ p.address ?: '-' }}</td>
                        <td>{{ p.seller ? p.seller.fullName : '-' }}</td>
                        <td>{{ p.buyer ? p.buyer.fullName : '-' }}</td>
                        {% set mortgageLabel = p.mortgage ? 'Con mutuo' : 'Senza mutuo' %}
                        <td class="txt_a_c"><img src="{{ asset(PATH_GRAPHICS ~ 'icons/' ~ (p.mortgage ? 'circle_green' : 'circle_red') ~ '.png') }}" class="icon_status" alt="{{ mortgageLabel }}" data-bs-toggle="tooltip" data-bs-title="{{ mortgageLabel }}"></td>
                        <td>{{ p.createdAt ? p.createdAt|date('d/m/Y') : '-' }}</td>
                        {# 12.1.8 Spazio occupato dagli allegati #}
                        <td class="txt_a_c">{{ p.sizeMb > 0 ? p.sizeMb|number_format(2, ',', '.') ~ ' MB' : '-' }}</td>
                        {# 12.1.9 Link alla scheda #}
                        <td class="txt_a_c">{{ ico.action(path('agency_practice_sheet', {id: p.id}), 'sheet', 'Apri la scheda', 'pr') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="10" class="op_07 text-center">Nessuna pratica {{ statuses[filters.status]|lower }} trovata.</td></tr>
                {% endfor %}
                </tbody>
            </table>
            {% include 'components/table/paginator.html.twig' with {records: records} only %}
        </div>
    </section>
{% endblock %}

{% block modals %}
    {# Filtri contrassegno (anche "nessuno") e tag: pratiche con almeno uno dei tag scelti #}
    {% include 'components/modals/filter_multi.html.twig' with {
        number: 2,
        title: 'Filtra per contrassegno',
        options: marks|map(m => {'id': m.id, 'label': m.value, 'color': m.color})|merge([{'id': 'none', 'label': 'Nessun contrassegno'}])
    } only %}
    {% include 'components/modals/filter_multi.html.twig' with {
        number: 3,
        title: 'Filtra per tag',
        options: tags|map(t => {'id': t.id, 'label': t.value, 'color': t.color})
    } only %}
{% endblock %}

{% block page_javascripts %}
{% include 'components/table/sort_js.html.twig' with {
    formName: 'practiceFilter', sortId: 'practiceFilter_sort', directionId: 'practiceFilter_direction',
    actualSort: filters.sortField ?: 'p.number', actualDirection: filters.sortField ? filters.sortOrder : 'asc'
} only %}
{% include 'components/js/filter_multi_js.html.twig' with {number: 2} only %}
{% include 'components/js/filter_multi_js.html.twig' with {number: 3} only %}
{# 12.1.2 Intervallo sulla data di creazione #}
{% include 'components/js/daterangepicker_js.html.twig' with {
    id: 'practiceFilter_created', format: 'DD/MM/YYYY', hasTimePicker: 'false'
} only %}
{% endblock %}
