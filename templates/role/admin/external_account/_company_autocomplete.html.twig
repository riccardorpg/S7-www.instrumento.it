{# Autocomplete inline per "Studio notarile di riferimento".
   Digitando in {prefix}_companyName mostra i risultati in {prefix}_companyResults (via AJAX);
   la scelta imposta {prefix}_company (hidden id) + la label nel campo. Generico per prefisso. #}
<script>
    (function () {
        var url = "{{ path('admin_external_account_company_search') }}";
        var timers = {};

        window.companySearch = function (prefix) {
            var input = document.getElementById(prefix + '_companyName');
            var hidden = document.getElementById(prefix + '_company');
            var box = document.getElementById(prefix + '_companyResults');
            if (!input || !hidden || !box) return;

            // L'id è valido solo se scelto dalla lista: digitando lo si azzera.
            hidden.value = '';
            var q = input.value.trim();

            clearTimeout(timers[prefix]);
            timers[prefix] = setTimeout(function () {
                fetch(url + '?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (items) {
                        box.innerHTML = '';
                        if (!items.length) {
                            var empty = document.createElement('div');
                            empty.className = 'list-group-item text-muted';
                            empty.textContent = 'Nessuno studio trovato.';
                            box.appendChild(empty);
                            box.style.display = 'block';
                            return;
                        }
                        items.forEach(function (it) {
                            var li = document.createElement('button');
                            li.type = 'button';
                            li.className = 'list-group-item list-group-item-action';
                            li.textContent = it.label;
                            li.addEventListener('click', function () {
                                input.value = it.label;
                                hidden.value = it.id;
                                box.style.display = 'none';
                            });
                            box.appendChild(li);
                        });
                        box.style.display = 'block';
                    });
            }, 250);
        };

        // Click fuori: chiude tutte le tendine risultati.
        document.addEventListener('click', function (e) {
            document.querySelectorAll('[id$="_companyResults"]').forEach(function (box) {
                var prefix = box.id.replace('_companyResults', '');
                var input = document.getElementById(prefix + '_companyName');
                if (box.contains(e.target) || (input && input.contains(e.target))) return;
                box.style.display = 'none';
            });
        });
    })();
</script>
