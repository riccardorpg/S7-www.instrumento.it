{% extends 'role/admin/layout.html.twig' %}

{% block title %} - Scrivania{% endblock %}
{% block role_page_title_inner %}Scrivania{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">
            {# La scrivania admin mostra solo gli allarmi: le sezioni si raggiungono dal menu. #}
            <ul class="nav nav-tabs canvas-alt-tabs tabs-tb" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-richieste" type="button">
                        Nuove richieste in arrivo <span class="badge bg-danger">{{ newRequests|length }}</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-demo" type="button">
                        Demo in scadenza <span class="badge bg-warning text-dark">{{ expiringDemos|length }}</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-licenze" type="button">
                        Licenze in scadenza <span class="badge bg-warning text-dark">{{ expiringLicenses|length }}</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-scartate" type="button">
                        Richieste scartate <span class="badge bg-secondary">{{ rejectedRequests|length }}</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content border border-top-0 p-3 bg-white">
                {# 6.1.1 Nuove richieste in arrivo #}
                <div class="tab-pane fade show active" id="tab-richieste">
                    {% include 'role/admin/_requests_table.html.twig' with {rows: newRequests, mode: 'pending'} only %}
                </div>

                {# 6.1.2 Demo in scadenza #}
                <div class="tab-pane fade" id="tab-demo">
                    {% include 'role/admin/_expiring_table.html.twig' with {'rows': expiringDemos} %}
                </div>

                {# 6.1.3 Licenze in scadenza #}
                <div class="tab-pane fade" id="tab-licenze">
                    {% include 'role/admin/_expiring_table.html.twig' with {'rows': expiringLicenses} %}
                </div>

                {# Archivio richieste scartate #}
                <div class="tab-pane fade" id="tab-scartate">
                    {% include 'role/admin/_requests_table.html.twig' with {rows: rejectedRequests, mode: 'rejected'} only %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block modals %}
    {% include 'role/admin/_request_detail_modal.html.twig' %}
    {% include 'components/modals/confirm.html.twig' with {type: 'demoRequest', title: 'Richieste demo'} only %}
{% endblock %}
