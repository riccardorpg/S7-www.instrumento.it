{% extends 'role/notary/layout.html.twig' %}
{% import 'components/action_icons.html.twig' as ico %}

{% block title %} - Pratiche{% endblock %}
{% block role_page_title_inner %}Pratiche{% endblock %}

{% block sub_menu_left %}
    <li class="nav-item"><a class="nav-link" href="{{ path('notary_index') }}"><i class="bi-arrow-left"></i> Torna alla scrivania</a></li>
{% endblock %}

{% block role_page_title_breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('notary_index') }}">Notaio</a></li>
    <li class="breadcrumb-item active" aria-current="page">Pratiche</li>
{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">
            <form id="practicesFilter" method="get" action="{{ path('notary_practices') }}">
                <input type="hidden" name="filterSet" value="1">
                <input type="hidden" id="practicesFilter_sort" name="sortField" value="{{ filters.sortField }}">
                <input type="hidden" id="practicesFilter_direction" name="sortOrder" value="{{ filters.sortOrder }}">
            </form>

            {# Una scheda per stato, col numero di pratiche (stessi filtri), come nell'area agenzia. La
               scheda attiva sta in sessione: il clic passa da notary_practice_tab, che la salva e torna all'elenco. #}
            {% set tabPlurals = {open: 'Aperte', completed: 'Completate', archived: 'Archiviate'} %}
            <ul class="nav nav-tabs canvas-alt-tabs tabs-tb m_b_20p" role="tablist">
                {% for value, label in statuses %}
                    <li class="nav-item">
                        <a class="nav-link{{ filters.status == value ? ' active' : '' }}" href="{{ path('notary_practice_tab', {status: value}) }}">
                            {{ tabPlurals[value]|default(label) }} <span class="badge bg-secondary">{{ statusCounts[value] }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>

            <div>
                <table class="table table-hover table-bordered align-middle m_b_none v_a_m">
                    <thead>
                        <tr class="tr_filter">
                            {# Codice, con "Escludi filtro" a sinistra #}
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    {{ ico.action(path('remove_filter', {route: 'notary_practices'}), 'close', 'Escludi filtro', 'red') }}
                                    <input form="practicesFilter" name="f_q" value="{{ filters.q }}" class="form-control form-control-sm">
                                </div>
                            </td>
                            {# Agenzia: scelta multipla in modale #}
                            <td>
                                <input form="practicesFilter" type="text" class="form-control form-control-sm cursor_p" id="filter_multi_value_2"
                                       readonly onclick="filterMulti2()" autocomplete="off">
                                <input form="practicesFilter" type="hidden" id="filter_multi_id_2" name="f_company" value="{{ filters.company }}">
                            </td>
                            <td><input form="practicesFilter" name="f_buyer" value="{{ filters.buyer }}" class="form-control form-control-sm"></td>
                            <td><input form="practicesFilter" name="f_seller" value="{{ filters.seller }}" class="form-control form-control-sm"></td>
                            <td><input form="practicesFilter" name="f_address" value="{{ filters.address }}" class="form-control form-control-sm"></td>
                            {# Filtra: sopra la colonna mutuo, la cella copre anche documenti e azioni (senza filtro) #}
                            <td colspan="3" class="text-nowrap">
                                <button form="practicesFilter" type="submit" class="btn p-0 border-0 bg-transparent" data-bs-toggle="tooltip" data-bs-title="Filtra">
                                    <img src="{{ asset(PATH_GRAPHICS ~ 'icons/search.png') }}" class="icon_action icon_green" alt="Filtra">
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <th class="td_w_120p">{{ ico.sort('Codice', 'p.number') }}</th>
                            <th class="td_w_200p">{{ ico.sort('Agenzia', 'c.name') }}</th>
                            <th class="td_w_200p">Acquirente</th>
                            <th class="td_w_200p">Venditore</th>
                            <th class="td_w_300p">{{ ico.sort('Indirizzo', 'p.address') }}</th>
                            <th class="td_w_70p">{{ ico.sort('Mutuo', 'p.mortgage') }}</th>
                            <th class="td_w_70p txt_a_c">Documenti</th>
                            <th class="td_w_50p txt_a_c">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for p in records %}
                        <tr>
                            <td><a href="{{ path('notary_practice_sheet', {id: p.id}) }}"><strong>{{ p.number }}</strong></a></td>
                            <td>{{ p.company.name }}</td>
                            <td>{{ p.buyer ? p.buyer.fullName : '-' }}</td>
                            <td>{{ p.seller ? p.seller.fullName : '-' }}</td>
                            <td>{{ p.address ?: '-' }}</td>
                            {# Mutuo: pallino verde (con) / rosso (senza), la label nel tooltip #}
                            <td class="txt_a_c">
                                <img src="{{ asset(PATH_GRAPHICS ~ 'icons/' ~ (p.mortgage ? 'circle_green' : 'circle_red') ~ '.png') }}" class="icon_status"
                                     alt="{{ p.typeLabel }}" data-bs-toggle="tooltip" data-bs-title="{{ p.typeLabel }}">
                            </td>
                            <td class="txt_a_c">
                                <span data-bs-toggle="tooltip" data-bs-title="Caricati / Richiesti">
                                    {{ p.countUploaded }} / {{ p.countRequested }}
                                </span>
                            </td>
                            <td class="txt_a_c">{{ ico.action(path('notary_practice_sheet', {id: p.id}), 'sheet', 'Scheda pratica', 'pr') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8" class="op_07 text-center">Nessuna pratica {{ statuses[filters.status]|lower }} trovata.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% include 'components/table/paginator.html.twig' with {records: records} only %}
            </div>
        </div>
    </section>
{% endblock %}

{% block modals %}
    {# Filtro agenzia: pratiche delle agenzie scelte #}
    {% include 'components/modals/filter_multi.html.twig' with {
        number: 2,
        title: 'Filtra per agenzia',
        options: companies|map(c => {'id': c.id, 'label': c.name})
    } only %}
{% endblock %}

{% block page_javascripts %}
{% include 'components/js/filter_multi_js.html.twig' with {number: 2} only %}
{% include 'components/table/sort_js.html.twig' with {
    formName: 'practicesFilter', sortId: 'practicesFilter_sort', directionId: 'practicesFilter_direction',
    actualSort: filters.sortField, actualDirection: filters.sortOrder
} only %}
{% endblock %}
