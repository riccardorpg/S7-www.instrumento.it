{% extends 'role/notary/layout.html.twig' %}
{% import 'components/action_icons.html.twig' as ico %}
{% import 'components/practice_status.html.twig' as practiceStatus %}

{% block title %} - Pratiche{% endblock %}
{% block role_page_title_inner %}Pratiche{% endblock %}

{% block sub_menu_left %}
    <li class="nav-item"><a class="nav-link" href="{{ path('notary_desk') }}"><i class="bi-arrow-left"></i> Torna alla scrivania</a></li>
{% endblock %}

{% block role_page_title_breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('notary_desk') }}">Notaio</a></li>
    <li class="breadcrumb-item active" aria-current="page">Pratiche</li>
{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">
            {% include 'role/notary/_agency_badge.html.twig' with {company: company} only %}

            <form id="practicesFilter" method="get" action="{{ path('notary_practices') }}">
                <input type="hidden" name="filterSet" value="1">
                <input type="hidden" id="practicesFilter_sort" name="sortField" value="{{ filters.sortField }}">
                <input type="hidden" id="practicesFilter_direction" name="sortOrder" value="{{ filters.sortOrder }}">
            </form>

            <div>
                <table class="table table-hover table-bordered align-middle m_b_none v_a_m">
                    <thead>
                        <tr class="tr_filter">
                            {# 1 Scheda: Escludi filtro (a sx) #}
                            <td class="txt_a_c">{{ ico.action(path('remove_filter', {route: 'notary_practices'}), 'close', 'Escludi filtro', 'red') }}</td>
                            {# 2 Stato #}
                            <td>
                                <select form="practicesFilter" name="f_status" class="form-select form-select-sm">
                                    <option value="">Tutti</option>
                                    <option value="open" {{ filters.status == 'open' ? 'selected' : '' }}>Aperta</option>
                                    <option value="completed" {{ filters.status == 'completed' ? 'selected' : '' }}>Completata</option>
                                    <option value="archivable" {{ filters.status == 'archivable' ? 'selected' : '' }}>Archiviabile</option>
                                </select>
                            </td>
                            {# 3 Dati pratica #}
                            <td><input form="practicesFilter" name="f_q" value="{{ filters.q }}" class="form-control form-control-sm"></td>
                            {# 4 Acquirente #}
                            <td><input form="practicesFilter" name="f_buyer" value="{{ filters.buyer }}" class="form-control form-control-sm"></td>
                            {# 5 Venditore #}
                            <td><input form="practicesFilter" name="f_seller" value="{{ filters.seller }}" class="form-control form-control-sm"></td>
                            {# 6 Documenti (nessun filtro) #}
                            {# 7 Azioni: Filtra (a dx) #}
                            <td colspan="2" class="text-nowrap">
                                <button form="practicesFilter" type="submit" class="btn p-0 border-0 bg-transparent" data-bs-toggle="tooltip" data-bs-title="Filtra">
                                    <img src="{{ asset(PATH_GRAPHICS ~ 'icons/search.png') }}" class="icon_action icon_green" alt="Filtra">
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <th class="td_w_40p txt_a_c"></th>
                            <th class="td_w_100p">{{ ico.sort('Stato', 'p.status') }}</th>
                            <th class="td_w_250p">{{ ico.sort('Dati pratica', 'p.number') }}</th>
                            <th class="td_w_120p">Acquirente</th>
                            <th class="td_w_120p">Venditore</th>
                            <th class="td_w_100p txt_a_c">Documenti</th>
                            <th class="td_w_40p txt_a_c">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for p in records %}
                        <tr>
                            <td class="txt_a_c">{{ ico.action(path('notary_practice_sheet', {id: p.id}), 'sheet', 'Scheda pratica', 'pr') }}</td>
                            <td>
                                {{ practiceStatus.badge(p.status, p.statusLabel) }}
                            </td>
                            <td>
                                <a href="{{ path('notary_practice_sheet', {id: p.id}) }}"><strong>{{ p.number }}</strong></a>
                                <span class="badge bg-light text-dark">{{ p.typeLabel }}</span>
                                {% if p.subject %}<div class="op_07 small">{{ p.subject|length > 70 ? p.subject|slice(0, 70) ~ '…' : p.subject }}</div>{% endif %}
                            </td>
                            <td>
                                {{ p.buyer ? p.buyer.fullName : '-' }}
                                {% if p.buyer and p.buyer.fiscalCode %}<div class="op_07 small">{{ p.buyer.fiscalCode }}</div>{% endif %}
                            </td>
                            <td>
                                {{ p.seller ? p.seller.fullName : '-' }}
                                {% if p.seller and p.seller.fiscalCode %}<div class="op_07 small">{{ p.seller.fiscalCode }}</div>{% endif %}
                            </td>
                            <td class="txt_a_c">
                                <span data-bs-toggle="tooltip" data-bs-title="Caricati / Richiesti">
                                    {{ p.countUploaded }} / {{ p.countRequested }}
                                </span>
                            </td>
                            <td class="txt_a_c">-</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="op_07 text-center">Nessuna pratica trovata.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% include 'components/table/paginator.html.twig' with {records: records} only %}
            </div>
        </div>
    </section>
{% endblock %}

{% block page_javascripts %}
{% include 'components/table/sort_js.html.twig' with {
    formName: 'practicesFilter', sortId: 'practicesFilter_sort', directionId: 'practicesFilter_direction',
    actualSort: filters.sortField, actualDirection: filters.sortOrder
} only %}
{% endblock %}
