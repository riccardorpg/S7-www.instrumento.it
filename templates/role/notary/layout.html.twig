{% extends 'role/base.html.twig' %}

{% block home_path %}{{ path('notary_index') }}{% endblock %}

{% block role_menu %}
    {% set r = app.request.attributes.get('_route') %}

    <li class="menu-item{{ r == 'notary_index' ? ' current' : '' }}">
        <a class="menu-link" href="{{ path('notary_index') }}"><div>Scrivania</div></a>
    </li>
    <li class="menu-item{{ r starts with 'notary_practice' ? ' current' : '' }}">
        <a class="menu-link" href="{{ path('notary_practices') }}"><div>Pratiche</div></a>
    </li>
    {# Lo staff lo gestisce solo il notaio, non i suoi collaboratori. #}
    {% if is_granted('ROLE_NOTARY') %}
        <li class="menu-item{{ r starts with 'notary_staff' ? ' current' : '' }}">
            <a class="menu-link" href="{{ path('notary_staff') }}"><div>Staff</div></a>
        </li>
    {% endif %}

    <li class="menu-item"><hr class="d-none d-lg-block color_w"></li>
    <li class="menu-item">
        <a class="menu-link" href="{{ path('logout') }}"><div>Esci</div></a>
    </li>
{% endblock %}

{% block role_page_title_breadcrumb %}
    {% set crumb_current = block('role_page_title_inner')|striptags|trim %}
    {% set isHome = app.request.attributes.get('_route') == 'notary_index' %}
    <li class="breadcrumb-item">
        {% if isHome %}
            Notaio
        {% else %}
            <a href="{{ path('notary_index') }}">Notaio</a>
        {% endif %}
    </li>
    {% if not isHome and crumb_current %}
        <li class="breadcrumb-item active" aria-current="page">{{ crumb_current }}</li>
    {% endif %}
{% endblock %}
