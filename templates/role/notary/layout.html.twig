{% extends 'role/base.html.twig' %}

{% block home_path %}{{ path(current_company() ? 'notary_desk' : 'notary_index') }}{% endblock %}

{% block role_menu %}
    {% set activeCompany = current_company() %}
    {# Con un'agenzia scelta la scrivania è la sua (avvisi); senza, la scelta dell'agenzia #}
    <li class="menu-item{{ app.request.attributes.get('_route') in ['notary_index', 'notary_desk'] ? ' current' : '' }}">
        <a class="menu-link" href="{{ path(activeCompany ? 'notary_desk' : 'notary_index') }}"><div>Scrivania</div></a>
    </li>

    {% if activeCompany %}
        {# Cambia agenzia subito sotto la scrivania #}
        <li class="menu-item">
            <a class="menu-link" href="{{ path('notary_deselect_agency') }}"><div>Cambia agenzia</div></a>
        </li>

        {# Agenzia selezionata: label non cliccabile (stile "azienda attiva" di venanzieffe) #}
        <li class="menu-item"><hr class="d-none d-lg-block"></li>
        <li class="menu-item menu-agency-label">
            <span class="menu-link" style="cursor:default;">
                <div style="font-size:11px; letter-spacing:.6px; text-transform:uppercase; opacity:.6;">Agenzia attiva</div>
                <div class="d-flex align-items-center" style="gap:8px;">
                    <span class="badge bg-secondary">{{ activeCompany.code }}</span>
                    <div>{{ activeCompany.name }}</div>
                </div>
            </span>
        </li>

        <li class="menu-item{{ app.request.attributes.get('_route') starts with 'notary_practice' ? ' current' : '' }}">
            <a class="menu-link" href="{{ path('notary_practices') }}"><div>Pratiche</div></a>
        </li>
        <li class="menu-item"><hr class="d-none d-lg-block"></li>
    {% endif %}

    <li class="menu-item">
        <a class="menu-link" href="{{ path('logout') }}"><div>Esci</div></a>
    </li>
{% endblock %}

{% block role_page_title_breadcrumb %}
    {% set crumb_current = block('role_page_title_inner')|striptags|trim %}
    {% set isHome = app.request.attributes.get('_route') in ['notary_index', 'notary_desk'] %}
    <li class="breadcrumb-item">
        {% if isHome %}
            Notaio
        {% else %}
            <a href="{{ path(current_company() ? 'notary_desk' : 'notary_index') }}">Notaio</a>
        {% endif %}
    </li>
    {% if not isHome and crumb_current %}
        <li class="breadcrumb-item active" aria-current="page">{{ crumb_current }}</li>
    {% endif %}
{% endblock %}
