{% extends 'role/notary/layout.html.twig' %}
{% import 'components/action_icons.html.twig' as ico %}

{% block title %} - Scrivania{% endblock %}
{% block role_page_title_inner %}Scrivania{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">
            {% include 'role/notary/_agency_badge.html.twig' with {company: company} only %}

            {# ===== Avvisi sulle pratiche assegnate al notaio, in due schede (la scheda attiva resta in
               sessione, tab_session): gli avvisi che l'agenzia cliente ha scelto di mostrargli e i
               documenti caricati in attesa del suo controllo ===== #}
            {% set activeTab = app.session.get('notary_desk_tab') == 'documenti' ? 'documenti' : 'avvisi' %}
            <div class="card">
                <div class="card-body">
                    <h6 class="m_b_10p">Avvisi pratiche</h6>

                    <ul class="nav nav-tabs canvas-alt-tabs tabs-tb m_b_10p" role="tablist">
                        <li class="nav-item">
                            <button type="button" class="nav-link tab_session{{ activeTab == 'avvisi' ? ' active' : '' }}" data-filter-tab="avvisi" data-bs-toggle="tab" data-bs-target="#desk-avvisi">
                                Avvisi cliente <span class="badge {{ alerts is empty ? 'bg-secondary' : 'bg-danger' }}">{{ alerts|length }}</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link tab_session{{ activeTab == 'documenti' ? ' active' : '' }}" data-filter-tab="documenti" data-bs-toggle="tab" data-bs-target="#desk-documenti">
                                Documenti da verificare <span class="badge {{ toVerify is empty ? 'bg-secondary' : 'bg-warning text-dark' }}">{{ toVerify|length }}</span>
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content">
                        {# (1) Avvisi dell'agenzia cliente, i più imminenti per primi #}
                        <div class="tab-pane fade{{ activeTab == 'avvisi' ? ' show active' : '' }}" id="desk-avvisi">
                            {% if alerts is empty %}
                                <p class="op_07 m_b_none">Nessun avviso dall'agenzia sulle pratiche a te assegnate.</p>
                            {% else %}
                                <table class="table table-hover align-middle m_b_none v_a_m">
                                    <thead>
                                        <tr>
                                            <th class="td_w_120p">Data</th>
                                            <th class="td_w_150p">Pratica</th>
                                            <th>Messaggio</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    {% for a in alerts %}
                                        <tr>
                                            <td>
                                                {{ a.remindAt|date('d/m/Y') }}
                                                {% if a.due %}<span class="badge bg-danger">scaduto</span>{% endif %}
                                            </td>
                                            <td><a href="{{ path('notary_practice_sheet', {id: a.practice.id}) }}">{{ a.practice.number }}</a></td>
                                            <td>{{ a.message }}</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            {% endif %}
                        </div>

                        {# (2) Documenti caricati e in attesa del controllo del notaio #}
                        <div class="tab-pane fade{{ activeTab == 'documenti' ? ' show active' : '' }}" id="desk-documenti">
                            {% if toVerify is empty %}
                                <p class="op_07 m_b_none">Nessun documento da verificare sulle pratiche a te assegnate.</p>
                            {% else %}
                                <table class="table table-hover align-middle m_b_none v_a_m">
                                    <thead>
                                        <tr>
                                            <th class="td_w_150p">Pratica</th>
                                            <th>Documento</th>
                                            <th class="td_w_100p txt_a_c">Allegati</th>
                                            <th class="td_w_70p txt_a_c">Scheda</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    {% for r in toVerify %}
                                        <tr>
                                            <td><a href="{{ path('notary_practice_sheet', {id: r.practice.id}) }}">{{ r.practice.number }}</a></td>
                                            <td>{{ r.label }}</td>
                                            <td class="txt_a_c">{{ r.documents|length }}</td>
                                            <td class="txt_a_c">{{ ico.action(path('notary_practice_sheet', {id: r.practice.id}), 'sheet', 'Apri la pratica', 'pr') }}</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block page_javascripts %}
    {% include 'components/js/tab_session_js.html.twig' %}
{% endblock %}
