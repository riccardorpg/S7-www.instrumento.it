{% extends 'role/notary/layout.html.twig' %}

{% block title %} - Scrivania{% endblock %}
{% block role_page_title_inner %}Scrivania{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">
            {% if current %}
                <div class="card mb-4">
                    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <div class="op_07">Agenzia selezionata</div>
                            <h4 class="m_b_none">{{ current.name }} <span class="badge bg-secondary">{{ current.code }}</span></h4>
                        </div>
                        <div class="text-nowrap">
                            <a href="{{ path('notary_practices') }}" class="button button-3d button-small button-green m_b_none">Pratiche</a>
                            <a href="{{ path('notary_deselect_agency') }}" class="button button-3d button-small button-red m_b_none">Cambia agenzia</a>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="card">
                <div class="card-body p-4">
                    <h5 class="mb-3">{{ current ? 'Cambia agenzia' : 'Seleziona agenzia' }}</h5>
                    {% if companies is empty %}
                        <div class="alert alert-warning m_b_none">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Nessuna agenzia abbinata al tuo profilo. Contatta l'amministratore per l'assegnazione.
                        </div>
                    {% else %}
                        <p class="op_07 m_b_20p">Per quale agenzia vuoi operare? Verranno mostrate le pratiche del suo archivio.</p>
                        <div class="row gx-3 gy-3">
                            {% for c in companies %}
                                <div class="col-12 col-sm-6 col-lg-4">
                                    <form method="post" action="{{ path('notary_select_agency') }}">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('notarySelectAgency') }}">
                                        <input type="hidden" name="company_id" value="{{ c.id }}">
                                        <button type="submit" class="rpg_customer_card{{ current and current.id == c.id ? ' is-current' : '' }}">
                                            <div class="rpg_logo_box">
                                                <span class="rpg_monogram">{{ c.name|trim|first|upper }}</span>
                                            </div>
                                            <div class="rpg_business">{{ c.name }}</div>
                                            <div class="rpg_meta"><span class="badge bg-secondary">{{ c.code }}</span></div>
                                            {% if c.vatNumber %}<div class="rpg_meta">P.IVA {{ c.vatNumber }}</div>{% endif %}
                                            {% if c.city %}<div class="rpg_meta">{{ c.city.name }}{% if c.province %} ({{ c.province.sign }}){% endif %}</div>{% endif %}
                                        </button>
                                    </form>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
