{% extends 'base.html.twig' %}

{% block title %} - Crea password{% endblock %}
{% block robots %}<meta name="robots" content="noindex, follow">{% endblock %}

{% block content %}
    <section class="eb-section" style="padding-top:150px; min-height:70vh;">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-7 col-lg-5">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h3 class="mb-1">Crea la tua password</h3>
                            <p class="text-muted mb-4">Scegli una password sicura per il tuo account.</p>

                            {# Le regole (4.1) le controlla il validator; l'indicatore qui sotto le mostra mentre si scrive. #}
                            {{ form_start(form, {attr: {id: 'pwForm', novalidate: 'novalidate'}}) }}
                                {# Errori non legati a un campo (es. sessione scaduta). #}
                                {% if form.vars.errors|length %}
                                    <div class="alert alert-danger">{% for error in form.vars.errors %}{{ error.message }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
                                {% endif %}

                                <div class="form-group mb-2">
                                    <div {{ form_errors(form.password) }}>
                                        <label class="form-label" for="{{ form.password.vars.id }}">Password</label>
                                        {{ form_widget(form.password) }}
                                    </div>
                                </div>

                                {# 4.1 indicatore forza password #}
                                <div class="mb-2">
                                    <div class="progress" style="height:6px;">
                                        <div id="pwBar" class="progress-bar" role="progressbar" style="width:0%;"></div>
                                    </div>
                                    <ul class="list-unstyled font_12 text-muted mt-2 mb-0" id="pwRules">
                                        <li data-rule="len"><i class="bi-circle"></i> Almeno 10 caratteri</li>
                                        <li data-rule="upper"><i class="bi-circle"></i> Una lettera maiuscola</li>
                                        <li data-rule="lower"><i class="bi-circle"></i> Una lettera minuscola</li>
                                        <li data-rule="digit"><i class="bi-circle"></i> Una cifra</li>
                                        <li data-rule="special"><i class="bi-circle"></i> Un carattere speciale</li>
                                    </ul>
                                </div>

                                <div class="form-group mb-3">
                                    <div {{ form_errors(form.passwordConfirm) }}>
                                        <label class="form-label" for="{{ form.passwordConfirm.vars.id }}">Conferma password</label>
                                        {{ form_widget(form.passwordConfirm) }}
                                    </div>
                                    <div class="font_12 mt-1" id="pwMatch"></div>
                                </div>

                                <button type="submit" id="pwSubmit" class="button button-3d button-rounded button-large m-0 w-100" style="background:var(--eb-brand);" disabled>Imposta password</button>
                            {{ form_end(form) }}

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block page_javascripts %}
<script>
(function () {
    var pw = document.getElementById({{ form.password.vars.id|json_encode|raw }}), pw2 = document.getElementById({{ form.passwordConfirm.vars.id|json_encode|raw }});
    var bar = document.getElementById('pwBar'), submit = document.getElementById('pwSubmit');
    var match = document.getElementById('pwMatch');
    var rulesEl = document.getElementById('pwRules');

    function checks(v) {
        return { len: v.length >= 10, upper: /[A-Z]/.test(v), lower: /[a-z]/.test(v), digit: /\d/.test(v), special: /[^A-Za-z0-9]/.test(v) };
    }
    function evaluate() {
        var v = pw.value, c = checks(v), passed = 0;
        Object.keys(c).forEach(function (k) {
            var li = rulesEl.querySelector('[data-rule="' + k + '"]');
            var icon = li.querySelector('i');
            if (c[k]) { passed++; icon.className = 'bi-check-circle-fill'; li.style.color = '#198754'; }
            else { icon.className = 'bi-circle'; li.style.color = ''; }
        });
        var pct = (passed / 5) * 100;
        bar.style.width = pct + '%';
        bar.style.background = pct < 40 ? '#dc3545' : (pct < 100 ? '#ffc107' : '#198754');

        var ok = passed === 5;
        var same = v.length > 0 && v === pw2.value;
        if (pw2.value.length > 0) {
            match.textContent = same ? 'Le password coincidono' : 'Le password non coincidono';
            match.style.color = same ? '#198754' : '#dc3545';
        } else { match.textContent = ''; }
        submit.disabled = !(ok && same);
    }
    pw.addEventListener('input', evaluate);
    pw2.addEventListener('input', evaluate);
})();
</script>
{% endblock %}
