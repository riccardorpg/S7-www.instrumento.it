{# Layout comune delle e-mail (stile Tillomeditalia): tabella a larghezza fissa, testata
   col marchio e chiusura firmata. Gli stili sono inline perché i client di posta
   ignorano i CSS esterni. #}
<!DOCTYPE html>
<html lang="it">
    <body style="margin:0; padding:0; background-color:#f4f5f7;">
        <table style="width:700px; max-width:100%; margin:auto; border:solid 1px #1D4ED8; border-collapse:collapse; background-color:#ffffff; font-family:Arial,Helvetica,sans-serif;">
            <tr>
                <td style="background-color:#1D4ED8; padding:20px; color:#ffffff; font-size:22px; font-weight:bold;">
                    Instrumento
                </td>
            </tr>
            {% block content %}{% endblock %}
            <tr>
                <td style="padding:20px; border-top:solid 1px #e6e8ee;">
                    <p style="color:#333; margin:0;">
                        Cordiali saluti<br>
                        Instrumento
                    </p>
                </td>
            </tr>
            <tr>
                <td style="padding:0 20px 20px 20px;">
                    <p style="color:#888; font-size:12px; margin:0;">
                        Messaggio automatico: non rispondere a questo indirizzo.
                    </p>
                </td>
            </tr>
        </table>
    </body>
</html>
