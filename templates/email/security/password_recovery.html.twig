{# 14.4 Recupero password: stesso link monouso, testo legato alla richiesta dell'utente. #}
{% extends 'email/base.html.twig' %}

{% block content %}
    <tr>
        <td style="padding:20px">
            <p style="color:#333">
                Buongiorno {{ name }},<br>
                abbiamo ricevuto una richiesta di recupero password per il suo account <strong>Instrumento</strong>.
            </p>
        </td>
    </tr>
    <tr>
        <td style="padding:0 20px 20px 20px">
            <p style="color:#333">
                Per impostare una nuova password clicchi sul link seguente:<br>
                <a href="{{ link }}" style="color:#1D4ED8;">{{ link }}</a>
            </p>
        </td>
    </tr>
    <tr>
        <td style="padding:0 20px 20px 20px">
            <p style="color:#333">
                Il link è valido fino al {{ expiresAt ? expiresAt|date('d/m/Y H:i') : 'termine indicato' }}.
                Se non ha richiesto il recupero, ignori questo messaggio: la password attuale resta valida.
            </p>
        </td>
    </tr>
{% endblock %}
