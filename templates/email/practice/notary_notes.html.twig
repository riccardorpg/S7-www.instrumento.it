{# 17.1.1.3 Il notaio ha inserito delle note su una pratica: avviso all'agente che la
   segue, inviato a mano dal notaio dalla scheda pratica. #}
{% extends 'email/base.html.twig' %}

{% block content %}
    <tr>
        <td style="padding:20px">
            <p style="color:#333">
                Buongiorno,<br>
                il notaio ha inserito delle note sui documenti della pratica
                <strong>{{ practice.number }}</strong> ({{ practice.typeLabel }}){% if practice.address %}, immobile in {{ practice.address }}{% endif %}.
            </p>
        </td>
    </tr>
    <tr>
        <td style="padding:0 20px 20px 20px">
            <p style="color:#333; margin:0">Accedi alla scheda della pratica per leggerle.</p>
        </td>
    </tr>
    <tr>
        <td style="padding:0 20px 20px 20px">
            <p style="color:#333">{{ notaryName }}</p>
        </td>
    </tr>
{% endblock %}
