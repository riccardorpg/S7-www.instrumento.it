{# 14.7 Notifica caricamento file: avviso di aggiornamento documenti su una pratica,
   inviato a mano dall'agenzia scegliendo il destinatario. #}
{% extends 'email/base.html.twig' %}

{% block content %}
    <tr>
        <td style="padding:20px">
            <p style="color:#333">
                Buongiorno,<br>
                ci sono aggiornamenti sui documenti della pratica <strong>{{ practice.number }}</strong>
                ({{ practice.typeLabel }}){% if practice.address %}, immobile in {{ practice.address }}{% endif %}.
            </p>
        </td>
    </tr>
    <tr>
        <td style="padding:0 20px 20px 20px">
            <p style="color:#333; margin:0; white-space:pre-line;">{{ message }}</p>
        </td>
    </tr>
    <tr>
        <td style="padding:0 20px 20px 20px">
            <p style="color:#333">{{ senderName }}</p>
        </td>
    </tr>
{% endblock %}
